---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {%- for page in collections.all %}
    {%- if page.url and "noindex" not in (page.data.metaRobots | default("")) and "/legal/" not in page.url %}
    <url>
        <loc>{{global_index.url}}{{ page.url | url }}</loc>
        {% if page.date %}<lastmod>{{ page.date.toISOString() }}</lastmod>{% endif %}
        {%- if page.url == '/' %}
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
        {%- elif '/tratamientos/' in page.url %}
        <changefreq>monthly</changefreq>
        <priority>0.8</priority>
        {%- elif '/blog/' in page.url %}
        <changefreq>monthly</changefreq>
        <priority>0.6</priority>
        {%- else %}
        <changefreq>monthly</changefreq>
        <priority>0.7</priority>
        {%- endif %}
    </url>
    {%- endif %}
    {%- endfor %}
</urlset>
